{
  "name": "kora-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test --concurrency=6",
    "benchmark:gates": "pnpm --filter @korajs/core test:benchmarks && pnpm --filter @korajs/store test:benchmarks && pnpm --filter @korajs/merge test:benchmarks && pnpm --filter @korajs/sync test:benchmarks",
    "chaos:nightly": "pnpm --filter @korajs/sync test:chaos && pnpm test:invariants:nightly",
    "test:invariants:nightly": "KORA_CHAOS_SEEDS=11,23,37,163,277,401,557,691,829,947,1117 pnpm --filter @korajs/test test -- tests/no-silent-loss-invariants.test.ts",
    "test:chaos:real-path": "pnpm --filter @korajs/test test -- tests/chaos-real-path.test.ts",
    "test:sync-reconnect": "pnpm --filter @korajs/test test -- tests/sync-reconnect.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "beta:bump": "node scripts/release/bump-beta.mjs",
    "beta:bump:dry": "node scripts/release/bump-beta.mjs --dry-run",
    "beta:release": "pnpm build && node scripts/release/bump-beta.mjs && changeset publish",
    "release": "pnpm build && changeset publish",
    "release:dry-run": "pnpm build && node scripts/release/validate-packages.mjs",
    "test:e2e": "pnpm --filter kora-e2e test:e2e",
    "test:production-path": "pnpm --filter korajs test:production-path",
    "test:release-gate": "pnpm test:production-path && pnpm test:sync-reconnect && pnpm test:chaos:real-path && pnpm benchmark:gates",
    "test:pre-release": "pnpm lint && pnpm build && pnpm test && pnpm typecheck && pnpm test:release-gate && pnpm --filter kora-e2e test:e2e:install && pnpm test:e2e",
    "test:pre-release:core": "pnpm lint && pnpm build && pnpm test && pnpm test:release-gate",
    "dev:full-stack": "pnpm --filter kora-full-stack dev",
    "verify:full-stack": "pnpm --filter kora-full-stack verify",
    "docs:dev": "pnpm --filter kora-docs dev",
    "docs:check-code": "node scripts/docs/check-code-blocks.mjs",
    "docs:check-tutorial": "node scripts/docs/check-getting-started.mjs",
    "remediation": "node scripts/remediation/check.mjs",
    "remediation:all": "node scripts/remediation/check.mjs --all"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.12",
    "tsup": "^8.3.6",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "protobufjs"]
  }
}
