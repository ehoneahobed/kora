{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "tests",
    "offline",
    "packed",
    "playwright.config.ts",
    "playwright.offline.config.ts",
    "playwright.packed.config.ts"
  ]
}
