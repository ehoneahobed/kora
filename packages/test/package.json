{
	"name": "@korajs/test",
	"version": "1.0.0-beta.14",
	"description": "Testing harness for Kora.js — create virtual device networks and assert convergence",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./playwright": {
			"import": {
				"types": "./dist/playwright.d.ts",
				"default": "./dist/playwright.js"
			},
			"require": {
				"types": "./dist/playwright.d.cts",
				"default": "./dist/playwright.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"bench:first-sync": "vitest run --config vitest.benchmark.config.ts",
		"bench:first-sync:browser": "node bench/browser/run.mjs",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.bench.json && tsc -p bench/browser/page/tsconfig.json",
		"lint": "biome check .",
		"clean": "rm -rf dist .turbo coverage"
	},
	"dependencies": {
		"@korajs/core": "workspace:*",
		"@korajs/merge": "workspace:*",
		"@korajs/store": "workspace:*",
		"@korajs/sync": "workspace:*",
		"@korajs/server": "workspace:*",
		"better-sqlite3": "^12.8.0",
		"korajs": "workspace:*"
	},
	"peerDependencies": {
		"korajs": "workspace:*",
		"playwright-core": ">=1.40.0"
	},
	"peerDependenciesMeta": {
		"korajs": {
			"optional": true
		},
		"playwright-core": {
			"optional": true
		}
	},
	"devDependencies": {
		"@korajs/spaces": "workspace:*",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.5.2",
		"playwright-core": "^1.59.1",
		"tsup": "^8.3.6",
		"typescript": "^5.7.3",
		"vitest": "^3.0.4",
		"yjs": "^13.6.30"
	},
	"license": "MIT"
}
