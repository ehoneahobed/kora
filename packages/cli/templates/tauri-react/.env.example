# Settings this app reads. A comment describes the variables right below it; tags set the
# rules: [required] production needs it, [secret] a credential, [development] local only.
# Hosts read this file to know what to ask for. Copy it to .env for local development.

# Sync server URL for the Tauri app. In development it defaults to ws://localhost:3001/kora-sync;
# for production builds set it to your deployed server, e.g. wss://my-app.onkora.app/kora-sync
# VITE_SYNC_URL=

# [development] Sync server port; hosts set PORT themselves.
PORT=3001

# Server database. Leave DATABASE_URL empty to use SQLite at KORA_SERVER_DB.
# Hosts such as Kora Cloud set DATABASE_URL for you.
KORA_SERVER_DB=./.kora/kora-server.db
DATABASE_URL=

# [secret] Bearer tokens for the operational endpoints (/__kora, /__kora/status,
# /__kora/events, /__kora/metrics, backups). Set them in production.
KORA_ADMIN_TOKEN=
KORA_METRICS_TOKEN=
KORA_BACKUP_TOKEN=

# Where the server keeps uploaded files (t.blob() fields). Set one; without either the
# server keeps no file bytes and files stay on devices. Hosts such as Kora Cloud set it.
# KORA_BLOB_STORE_URL: s3://<bucket>, or https://<account>.blob.core.windows.net/<container>
# KORA_BLOB_DIR: a directory that survives restarts
KORA_BLOB_STORE_URL=
KORA_BLOB_DIR=

# Optional sync path
KORA_SYNC_PATH=/kora-sync

# [secret] Signs sign-in sessions; needed when auth is enabled.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
KORA_AUTH_SECRET=

# [secret] Earlier sign-in secrets, comma-separated, still accepted so changing KORA_AUTH_SECRET
# signs nobody out. Remove one once sessions have refreshed (90 days at most).
KORA_AUTH_SECRET_PREVIOUS=
